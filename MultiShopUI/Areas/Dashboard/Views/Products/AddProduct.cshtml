@using Entities.Dto.ProductDtos
@model ProductAddDto

@{
    ViewData["Title"] = "Yeni Məhsul Əlavə Et";
}

<div class="container mt-5">
    <div class="card shadow-lg border-0 rounded-4">
        <div class="card-header bg-primary text-white rounded-top-4">
            <h3 class="mb-0"><i class="bi bi-plus-circle me-2"></i>Yeni Məhsul Əlavə Et</h3>
        </div>
        <div class="card-body">
            <form asp-action="AddProduct" method="post" enctype="multipart/form-data">
                <div class="row g-4">

                    <div class="col-md-6">
                        <label asp-for="Name" class="form-label fw-bold"></label>
                        <input asp-for="Name" class="form-control" />
                        <span asp-validation-for="Name" class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Price" class="form-label fw-bold"></label>
                        <input asp-for="Price" class="form-control" type="number" step="0.01" />
                        <span asp-validation-for="Price" class="text-danger"></span>
                    </div>

                    <div class="col-md-12">
                        <label asp-for="Description" class="form-label fw-bold"></label>
                        <textarea asp-for="Description" class="form-control" rows="2"></textarea>
                        <span asp-validation-for="Description" class="text-danger"></span>
                    </div>

                    <div class="col-md-12">
                        <label asp-for="Spesification" class="form-label fw-bold"></label>
                        <textarea asp-for="Spesification" class="form-control" rows="2"></textarea>
                        <span asp-validation-for="Spesification" class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="IsDiscount" class="form-label fw-bold me-2"></label>
                        <div class="form-check">
                            <input asp-for="IsDiscount" class="form-check-input" type="checkbox" />
                            <label class="form-check-label">Endirim Var</label>
                        </div>
                        <span asp-validation-for="IsDiscount" class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="DiscountPrice" class="form-label fw-bold"></label>
                        <input asp-for="DiscountPrice" class="form-control" type="number" step="0.01" />
                        <span asp-validation-for="DiscountPrice" class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="IsDelivery" class="form-label fw-bold me-2"></label>
                        <div class="form-check">
                            <input asp-for="IsDelivery" class="form-check-input" type="checkbox" />
                            <label class="form-check-label">Çatdırılma Var</label>
                        </div>
                        <span asp-validation-for="IsDelivery" class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="ShippingCost" class="form-label fw-bold"></label>
                        <input asp-for="ShippingCost" class="form-control" type="number" step="0.01" />
                        <span asp-validation-for="ShippingCost" class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Stock" class="form-label fw-bold"></label>
                        <input asp-for="Stock" class="form-control" type="number" />
                        <span asp-validation-for="Stock" class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="IsFeatured" class="form-label fw-bold me-2"></label>
                        <div class="form-check">
                            <input asp-for="IsFeatured" class="form-check-input" type="checkbox" />
                            <label class="form-check-label">Ön Planda</label>
                        </div>
                        <span asp-validation-for="IsFeatured" class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label fw-bold">Kateqoriya</label>
                        <select asp-for="CategoryId" class="form-select" asp-items="ViewBag.Categories"></select>
                        <span asp-validation-for="CategoryId" class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label fw-bold">Brend</label>
                        <select asp-for="BrandId" class="form-select" asp-items="ViewBag.Brands"></select>
                        <span asp-validation-for="BrandId" class="text-danger"></span>
                    </div>

                    <div class="col-md-12">
                        <label for="productImages" class="form-label fw-bold">Məhsul Şəkilləri</label>
                        <input type="file" name="productImages" class="form-control" multiple />
                    </div>
                </div>

                <div class="mt-4 text-end">
                    <button type="submit" class="btn btn-success px-4">
                        <i class="bi bi-check-circle me-1"></i> Əlavə Et
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">
