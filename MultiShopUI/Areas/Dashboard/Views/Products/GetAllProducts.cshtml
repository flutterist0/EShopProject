@using Entities.Dto.ProductDtos
@model List<ProductListDto>

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="fw-bold">📦 Product List</h2>
        <a href="@Url.Action("AddProduct", "Products")" class="btn btn-success shadow-sm">
            <i class="bi bi-plus-circle me-1"></i> Add Product
        </a>
    </div>

    @if (Model != null && Model.Any())
    {
        <div class="table-responsive shadow-sm rounded">
            <table class="table table-hover table-bordered align-middle">
                <thead class="table-dark">
                    <tr class="text-center">
                        <th>ID</th>
                        <th>Name</th>
                        <th>Price</th>
                        <th>Discount</th>
                        <th>Delivery</th>
                        <th>Discounted</th>
                        <th>Featured</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var product in Model)
                    {
                        <tr class="text-center">
                            <td>@product.ProductId</td>
                            <td class="fw-semibold">@product.Name</td>
                            <td>$@product.Price</td>
                            <td>
                                @if (product.DiscountPrice > 0)
                                {
                                    <span class="badge bg-warning text-dark">$@product.DiscountPrice</span>
                                }
                                else
                                {
                                    <span class="text-muted">-</span>
                                }
                            </td>
                            <td>
                                <span class="badge @(product.IsDelivery ? "bg-success" : "bg-secondary")">
                                    @(product.IsDelivery ? "Yes" : "No")
                                </span>
                            </td>
                            <td>
                                <span class="badge @(product.IsDiscount ? "bg-primary" : "bg-secondary")">
                                    @(product.IsDiscount ? "Yes" : "No")
                                </span>
                            </td>
                            <td>
                                <span class="badge @(product.IsFeatured ? "bg-info" : "bg-secondary")">
                                    @(product.IsFeatured ? "Yes" : "No")
                                </span>
                            </td>
                            <td>
                                <a href="@Url.Action("UpdateProduct","Products", new { id = product.ProductId })" class="btn btn-outline-warning btn-sm me-1">
                                    <i class="bi bi-pencil-square"></i> Edit
                                </a>
                                <a href="@Url.Action("Delete","Products", new { id = product.ProductId })" class="btn btn-outline-danger btn-sm">
                                    <i class="bi bi-trash"></i> Delete
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="alert alert-info shadow-sm text-center" role="alert">
            <i class="bi bi-exclamation-circle me-2"></i> No products found.
        </div>
    }
</div>

<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet">
