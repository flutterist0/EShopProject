@using Entities.Dto.ProductDtos
@model ProductUpdateDto

<h2 class="my-4 text-primary">🛠️ Məhsulu Redaktə Et</h2>

<form asp-area="Dashboard" asp-controller="Products" asp-action="UpdateProduct" method="post" enctype="multipart/form-data" onsubmit="return confirm('Update etmək istədiyinizə əminsinizmi?');">
    <input type="hidden" asp-for="ProductId" />

    <div class="row">
        <div class="col-md-6 mb-3">
            <label asp-for="Name" class="form-label"></label>
            <input asp-for="Name" class="form-control" />
            <span asp-validation-for="Name" class="text-danger"></span>
        </div>

        <div class="col-md-6 mb-3">
            <label asp-for="Price" class="form-label"></label>
            <input asp-for="Price" class="form-control" />
            <span asp-validation-for="Price" class="text-danger"></span>
        </div>

        <div class="col-md-6 mb-3">
            <label asp-for="Stock" class="form-label"></label>
            <input asp-for="Stock" class="form-control" />
            <span asp-validation-for="Stock" class="text-danger"></span>
        </div>

        <div class="col-md-6 mb-3">
            <label asp-for="ShippingCost" class="form-label"></label>
            <input asp-for="ShippingCost" class="form-control" />
            <span asp-validation-for="ShippingCost" class="text-danger"></span>
        </div>

        <div class="col-12 mb-3">
            <label asp-for="Description" class="form-label"></label>
            <textarea asp-for="Description" class="form-control" rows="3"></textarea>
        </div>

        <div class="col-12 mb-3">
            <label asp-for="Spesification" class="form-label"></label>
            <textarea asp-for="Spesification" class="form-control" rows="3"></textarea>
        </div>

        <div class="col-md-4 form-check mb-2">
            <input asp-for="IsDiscount" class="form-check-input" type="checkbox" />
            <label asp-for="IsDiscount" class="form-check-label"></label>
        </div>

        <div class="col-md-4 form-check mb-2">
            <input asp-for="IsDelivery" class="form-check-input" type="checkbox" />
            <label asp-for="IsDelivery" class="form-check-label"></label>
        </div>

        <div class="col-md-4 form-check mb-2">
            <input asp-for="IsFeatured" class="form-check-input" type="checkbox" />
            <label asp-for="IsFeatured" class="form-check-label"></label>
        </div>

        <div class="col-md-6 mb-3">
            <label asp-for="DiscountPrice" class="form-label"></label>
            <input asp-for="DiscountPrice" class="form-control" />
        </div>

        <div class="col-md-6 mb-3">
            <label asp-for="CategoryId" class="form-label"></label>
            <select asp-for="CategoryId" class="form-control" asp-items="ViewBag.Categories"></select>
        </div>

        <div class="col-md-6 mb-3">
            <label asp-for="BrandId" class="form-label"></label>
            <select asp-for="BrandId" class="form-control" asp-items="ViewBag.Brands"></select>
        </div>

        <div class="col-12 mb-4">
            <h5 class="text-info">📸 Mövcud Şəkillər</h5>
            <div class="d-flex flex-wrap gap-3">
                @foreach (var image in Model.ExistingImages)
                {
                    <div class="border p-2 text-center" style="width: 120px;">
                        <img src="@image.ImageUrl" alt="Product Image" class="img-thumbnail mb-1" style="width: 100px; height: 100px; object-fit: cover;" />
                        <div class="form-check">
                            <input type="checkbox" name="DeleteImages" value="@image.Id" class="form-check-input" id="img-@image.Id" />
                            <label for="img-@image.Id" class="form-check-label small text-danger">Sil</label>
                        </div>
                    </div>
                }
            </div>
        </div>

        <div class="col-12 mb-3">
            <label for="newImages" class="form-label">Yeni Şəkillər Əlavə Et</label>
            <input type="file" name="ProductImages" multiple class="form-control" />
        </div>

        <div class="col-12 mt-4">
            <button type="submit" class="btn btn-success btn-lg w-100">💾 Məhsulu Yadda Saxla</button>
        </div>
    </div>
</form>
