@using Core.Entities.Concrete
@model UserOperationClaim

<div class="container">
    <h2 class="my-4 text-center text-primary">User Operation Claim Əlavə Et</h2>

    <form asp-action="AddOperationClaim" method="post" enctype="multipart/form-data">
        <div class="row">
            <div class="col-md-6 mx-auto">
                <div class="form-group">
                    <label class="control-label" for="UserId">User</label>
                    <select asp-for="UserId" class="form-control" asp-items="ViewBag.Users">
                        <option value="">Seçin...</option>
                    </select>
                    <span asp-validation-for="UserId" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label class="control-label" for="OperationClaimId">Operation Claim</label>
                    <select asp-for="OperationClaimId" class="form-control" asp-items="ViewBag.OperationClaims">
                        <option value="">Seçin...</option>
                    </select>
                    <span asp-validation-for="OperationClaimId" class="text-danger"></span>
                </div>

                <div class="form-group text-center mt-4">
                    <button type="submit" class="btn btn-success btn-lg">Əlavə Et</button>
                </div>
            </div>
        </div>
    </form>
</div>
